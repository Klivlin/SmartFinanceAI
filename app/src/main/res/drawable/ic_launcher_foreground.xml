<?xml version="1.0" encoding="utf-8"?>
<!--
    Логотип приложения — кольцо + ромб, тот же мотив, что и AppLogo() в
    core/ui/components/PremiumSurfaces.kt (используется как центрированный фоновый знак на
    каждом экране) и TitleRule() (разделитель под заголовками экранов) — единственный
    повторяющийся графический акцент интерфейса, поэтому и лёг в основу иконки приложения,
    а не отдельная, нигде больше не встречающаяся картинка. Цвета — реальная палитра приложения
    (neutral_900/neutral_300, core/ui/theme/Color.kt), а не случайный синий, как раньше.
    Вписан в безопасную зону адаптивной иконки (круг радиусом 30 из 108, центр 54,54).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Кольцо -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#111111"
        android:strokeWidth="5"
        android:pathData="M84,54 A30,30 0 1,1 83.99,53.5" />
    <!-- Ромб в центре — тот же акцент, что и в AppLogo()/TitleRule() -->
    <path
        android:fillColor="#BEB8AD"
        android:pathData="M54,44 L64,54 L54,64 L44,54 Z" />
</vector>
